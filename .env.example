# ── Opium Platform — Environment Variables ──────────────────

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/opium?schema=public"

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=sua-chave-secreta-aqui

# Google OAuth
GOOGLE_CLIENT_ID=seu-google-client-id
GOOGLE_CLIENT_SECRET=seu-google-client-secret

# Pix / Gateway de Pagamento (ex: Mercadopago, Asaas, PushinPay)
PIX_API_KEY=sua-chave-api-pix
PIX_WEBHOOK_URL=https://seudominio.com/api/pix/webhook
PIX_BASE_URL=https://api.pagamento.com/v1

# Storage de vídeos (ex: S3, Bunny, etc.)
STORAGE_ENDPOINT=https://storage.seubucket.com
STORAGE_KEY=sua-access-key
STORAGE_SECRET=sua-secret-key
STORAGE_BUCKET=opium-videos

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
