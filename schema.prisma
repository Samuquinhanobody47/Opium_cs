// ─────────────────────────────────────────────────────────────
// Opium Platform — Prisma Schema
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────

enum Role {
  FUNDADOR
  ADM
  COLABORADOR
  ALUNO
}

enum CourseLevel {
  BASICO
  BOM
  COMPLETO
  VIP
}

enum VideoStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── Models ───────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  role           Role      @default(ALUNO)
  googleId       String?   @unique
  commission     Float     @default(0)    // saldo de comissões (R$)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  accounts       Account[]
  sessions       Session[]
  purchases      Purchase[]
  sentVideos     Video[]   @relation("UploadedVideos")
  reviewedVideos Video[]   @relation("ReviewedVideos")
  referrals      Referral[] @relation("ReferralReferrer")
  purchaseReferrals Purchase[] @relation("PurchaseReferrer")
  chatMessages   ChatMessage[]
  lessonProgress LessonProgress[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

// ── Courses ─────────────────────────────────────────────────

model Course {
  id          String      @id @default(cuid())
  title       String
  description String?
  level       CourseLevel
  price       Float       // em R$
  isActive     Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  modules     Module[]
  purchases   Purchase[]

  @@map("courses")
}

model Module {
  id        String   @id @default(cuid())
  courseId   String
  title      String
  order      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]

  @@map("modules")
}

model Lesson {
  id        String   @id @default(cuid())
  moduleId   String
  title      String
  order      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  video     Video?     @relation("LessonVideo")
  progress  LessonProgress[]

  @@map("lessons")
}

model Video {
  id          String      @id @default(cuid())
  title       String
  description String?
  url         String      // URL do vídeo armazenado
  thumbnail   String?
  duration    Int?        // em segundos
  status      VideoStatus @default(PENDING)
  uploadedBy  String      // userId do colaborador
  reviewedBy  String?     // userId do ADM/Fundador
  reviewedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  uploader    User        @relation("UploadedVideos", fields: [uploadedBy], references: [id])
  reviewer    User?       @relation("ReviewedVideos", fields: [reviewedBy], references: [id])
  lesson      Lesson?     @relation("LessonVideo", fields: [lessonId], references: [id])
  lessonId    String?     @unique

  @@map("videos")
}

// ── Purchases / Checkout ────────────────────────────────────

model Purchase {
  id            String    @id @default(cuid())
  userId        String
  courseId       String
  amount        Float     // valor pago em R$
  pixId         String?   // ID do pagamento no gateway Pix
  pixCode       String?   @db.Text
  pixQrCode     String?   @db.Text
  pixExpiresAt  DateTime?
  paidAt        DateTime?
  status        String    @default("PENDING")  // PENDING | PAID | EXPIRED | FAILED
  referredBy    String?   // userId do colaborador/ADM que indicou
  commission    Float?    @default(0)   // comissão de R$1 se houve indicação
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course        Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  referrer      User?     @relation("PurchaseReferrer", fields: [referredBy], references: [id])
  referral      Referral? //反向: uma Purchase pode ter no máximo uma Referral

  @@map("purchases")
}

// ── Referrals ───────────────────────────────────────────────

model Referral {
  id          String   @id @default(cuid())
  referrerId  String   // quem indicou
  purchaseId  String   @unique
  commission  Float    @default(1.0) // R$1 por indicação
  paidOut     Boolean  @default(false) // comissão já foi paga ao indicador?
  createdAt   DateTime @default(now())

  referrer    User     @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@map("referrals")
}

// ── Donations ───────────────────────────────────────────────

model Donation {
  id           String    @id @default(cuid())
  userId       String?
  name         String?   // nome do doador (ou "Anônimo")
  amount       Float
  pixId        String?   // ID do pagamento no gateway Pix
  pixCode      String?   @db.Text
  pixQrCode    String?   @db.Text
  pixExpiresAt DateTime?
  paidAt       DateTime?
  status       String    @default("PENDING")
  createdAt    DateTime  @default(now())

  @@map("donations")
}

// ── Chat ────────────────────────────────────────────────────

model ChatMessage {
  id        String    @id @default(cuid())
  userId    String
  room      String    // sala dinâmica: geral, colaboradores, adms, fundadores, gestao-precos
  content   String    @db.Text
  createdAt DateTime  @default(now())

  sender    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

// ── Lesson Progress ─────────────────────────────────────────

model LessonProgress {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

// ── Settings (Key-Value) ────────────────────────────────────

model Settings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("settings")
}